# Copy into server/.env (server/.env is gitignored).
# See server/db/migrations/ for manual migration steps.

# --- Required ---

# PostgreSQL connection string (URI format)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Express server port (default 3000)
PORT=3000

# Public backend URL
API_URL=http://localhost:3000

# Frontend URL (CORS)
# Production: your Netlify URL, e.g. https://your-app.netlify.app
# Netlify branch/deploy previews are allowed automatically when CLIENT_URL uses *.netlify.app
CLIENT_URL=http://localhost:5173

# --- Supabase Auth (Phase 11) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Deploy (production) ---

# NODE_ENV=production
